# Reload

on left click:
    if {reloadtime::%uuid of player%} is not set:
        set {reloadtime::%uuid of player%} to 0
    if {reloadtime::%uuid of player%} is 0:
        if player is holding a spyglass named "L30 LTR":
            cancel event
            if player's inventory contains iron ingot named "L30 Mag":
                play sound "minecraft:mfourreload" to player
                set item cooldown of player's tool for player to 3 seconds
                remove 1 iron ingot named "L30 Mag" from player's inventory
                set {ltrAmmo::%uuid of player%} to 5
                set {reload::%uuid of player%} to now
                set {reloadtime::%uuid of player%} to 3 seconds
                wait 3 seconds
                set {reloadtime::%uuid of player%} to 0

on swap hand items:
    if {reloadtime::%uuid of player%} is not set:
        set {reloadtime::%uuid of player%} to 0
    if {reloadtime::%uuid of player%} is 0:
        if player is holding a red dye:
            cancel event
            if player's inventory contains iron ingot named "Glock Mag":
                play sound "minecraft:glockreload" to player
                set item cooldown of player's tool for player to 2 seconds
                remove 1 iron ingot named "Glock Mag" from player's inventory
                set {glockAmmo::%uuid of player%} to 10
                set {reload::%uuid of player%} to now
                set {reloadtime::%uuid of player%} to 2.2 seconds
                wait 2.2 seconds
                set {reloadtime::%uuid of player%} to 0
        if player is holding a black dye:
            cancel event
            if player's inventory contains iron ingot named "M4A1 Mag":
                play sound "minecraft:mfourreload" to player
                set item cooldown of player's tool for player to 3 seconds
                remove 1 iron ingot named "M4A1 Mag" from player's inventory
                set {m4Ammo::%uuid of player%} to 30
                set {reload::%uuid of player%} to now
                set {reloadtime::%uuid of player%} to 3 seconds
                wait 3 seconds
                set {reloadtime::%uuid of player%} to 0
        if player is holding a pink dye:
            cancel event
            if player's inventory contains iron ingot named "Minigun Chain":
                play sound "minecraft:mfourreload" to player
                set item cooldown of player's tool for player to 6 seconds
                remove 1 iron ingot named "Minigun Chain" from player's inventory
                set {miniAmmo::%uuid of player%} to 50
                set {reload::%uuid of player%} to now
                set {reloadtime::%uuid of player%} to 6 seconds
                wait 6 seconds
                set {reloadtime::%uuid of player%} to 0

        if player is holding a green dye:
            cancel event
            if player's inventory contains iron ingot named "Grenade Mag":
                play sound "minecraft:mfourreload" to player
                set item cooldown of player's tool for player to 5 seconds
                remove 1 iron ingot named "Grenade Mag" from player's inventory
                set {grenadeAmmo::%uuid of player%} to 8
                set {reload::%uuid of player%} to now
                set {reloadtime::%uuid of player%} to 4 seconds
                wait 4 seconds
                set {reloadtime::%uuid of player%} to 0

        if player is holding a orange dye:
            cancel event
            if player's inventory contains iron ingot named "Vector Mag":
                play sound "minecraft:mfourreload" to player
                set item cooldown of player's tool for player to 1.5 seconds
                remove 1 iron ingot named "Vector Mag" from player's inventory
                set {krissAmmo::%uuid of player%} to 20
                set {reload::%uuid of player%} to now
                set {reloadtime::%uuid of player%} to 1.5 seconds
                wait 1.5 seconds
                set {reloadtime::%uuid of player%} to 0

        if player is holding a lime dye:
            cancel event
            if player's inventory contains iron ingot named "FAMAS Mag":
                play sound "minecraft:mfourreload" to player
                set item cooldown of player's tool for player to 3 seconds
                remove 1 iron ingot named "FAMAS Mag" from player's inventory
                set {famasAmmo::%uuid of player%} to 30
                set {reload::%uuid of player%} to now
                set {reloadtime::%uuid of player%} to 3 seconds
                wait 3 seconds
                set {reloadtime::%uuid of player%} to 0



## OTHER WEAPONS

on projectile hit:
    if event-projectile is a snowball:
        if event.getHitBlock() is set:
            set {_block} to event.getHitBlock()
        cancel event
        set {_shape} to a sphere with radius 4
        set {_part} to dust particle using dustOption(rgb(109, 96, 96), 10) 
        set particle of {_shape} to {_part}
        set {_shape}'s particle density to 1.5
        loop 5 times:
            draw shape {_shape} at {_block}
            wait 0.8 second         

    if event-projectile is a egg:
        if event.getHitBlock() is set:
            set {_block} to event.getHitBlock()
        cancel event
        create an explosion of force 1.4 at {_block}
        make shooter of event-projectile damage all players in radius 3 of {_block} by 9

        
## EFFECTS
every 1 second:
    if {gameTime} > 0:
        if {started} is true:
            if {gameTime} is 300:
                broadcast "&c&l5 Minutes Remaining"
            if {gameTime} is 120:
                broadcast "&c&l2 Minutes Remaining"
            if {gameTime} is 60:
                broadcast "&c&l1 Minute Remaining"
            
            set bar progress of {bar} to (({gameTime}/600)*100)
            add -1 to {gameTime}
    else:
        if {started} is true:
            set {started} to false
            endGame()
            remove all players from {bar}
            delete {bar}
            set {gameTime} to 99999999

    loop all players:
        if loop-player is holding a pink dye:
            apply slowness potion of tier 2 without any particles whilst hiding the potion icon to loop-player for 1 second
        else if custom model data strings of loop-player's tool is "vectoraim":
            apply slowness potion of tier 2 without any particles whilst hiding the potion icon to loop-player for 1 second

every 30 seconds:
    if {started} is true:
        send actionbar "&fGlowing" to all players
        apply glowing potion of tier 1 without any particles whilst hiding the potion icon to all players for 4.5 seconds



on sheep dye:
    cancel event

on player spawn change:
    if event-playerspawnchangereason = bed:
        cancel event

on damage:
    set {_loc} to location of victim
    add 1 to y-coordinate of {_loc}
    draw 15 of block using nether wart block at {_loc}

on damage:
    if attacker is a player:
        if {hitDing::%uuid of attacker%} is true:
            play sound {hitDingNoise::%uuid of attacker%} with volume 0.8 and pitch 1 to attacker

on break:
    event.setDropItems(false)

on drop:
    if event-entity is not a player:
        cancel event

on craft:
    cancel event

on player world change:
    set {radio::%uuid of event-player%} to 0

on command "/radio":
    wait 10 tick
    if {radio::%uuid of event-player%} is 1:
        while player is online:
            if {radio::%uuid of event-player%} is 0:
                stop
            if {songlist::%uuid of event-player%::*} is not set:
                set {songlist::%uuid of event-player%::*} to "smellsliketeenspirit", "routinesinthenight", "jigsawfallingintoplace", "always", "onelastbreath", "mapoftheproblem", "theemptinessmachine"

            set {_song} to a random element out of {songlist::%uuid of player%::*}
            play sound "minecraft:%{_song}%" in hostile category with volume 1 to event-player
            remove {_song} from {songlist::%uuid of event-player%::*}
            loop 259 times:
                if {radio::%uuid of event-player%} is 0:
                    stop
                wait 1 second
    


on join:
    #
    if {killPoints::%uuid of player%} is not set:
        set {killPoints::%uuid of player%} to 0
    if {upgrades::%uuid of player%::killcash} is not set:
        set {upgrades::%uuid of player%::killcash} to 5
    if {diveTrigger::%uuid of player%} is not set:
        set {diveTrigger::%uuid of player%} to "click"

    toggle player's fastboard on
    set title of player's fastboard to "&e[Points]"
    set line 1 of player's fastboard to "&cKill Points - %{killPoints::%uuid of player%}%"
    wait 1 second
    execute console command "/mv teleport %player% hub"
    if {team::%uuid of player%} is set:
        make player execute command "/leavegame"

    if {hitDing::%uuid of player%} is not set:
        set {hitDing::%uuid of player%} to false

    if {hitDingNoise::%uuid of player%} is not set:
        set {hitDingNoise::%uuid of player%} to "minecraft:block.note_block.bell"

    set tick rate of player to 120




## DEBUG

command /resourcepack:
    trigger:
        set {pack::1} to random uuid
        send resource pack from url "https://6891497fc33e919b1f1505e3.manager.minehut.com/v1/resource_packs/84e2769f-0675-41c3-88ef-360c36c12d11" with uuid {pack::1} with prompt "This Adds Cool Stuff!!!" to player with force

command /resetmap:
    permission: op 
    trigger:
        delete {breakStage::*}
command /endgame:
    permission: op
    trigger:
        set {gameTime} to 99999999
        endGame()
    
command /toggletimer:
    trigger:
        if {bar::%uuid of player%} is true:
            remove player from {bar}
            set {bar::%uuid of player%} to false
        else:
            add player to {bar}
            set {bar::%uuid of player%} to true
        
command /startbar:
    permission: op
    trigger:
        startTimer()

command /togglescore:
    trigger:
        if {gameType} is "team":
            toggle player's fastboard
        
        if {gameType} is "ffa":
            #reset scoreboard of player

command /toggledhitding:
    trigger:
        if {hitDing::%uuid of player%} is false:
            set {hitDing::%uuid of player%} to true
            send "&bHit ding is now enabled" to player
        else:
            set {hitDing::%uuid of player%} to false
            send "&bHit ding is now disabled" to player
    
command /sethitding <string>:
    usage: /sethitding <minecraft noise> for example: /sethitding minecraft:block.note_block.bell or you can reset with /sethitding reset
    trigger:
        if arg is "reset":
            set {hitDingNoise::%uuid of player%} to "minecraft:block.note_block.bell"
        else:
            set {hitDingNoise::%uuid of player%} to arg

    
command /givemoney <number>:
    permission: op
    trigger:
        add arg to {cash::%uuid of player%}
command /addscore:
    permission: op
    trigger:
        add 5 to {redPoints}

command /hide:
    permission: op
    trigger:
        addNoTag(player)

command /show:
    permission: op
    trigger:
        removeNoTag(player)

command /bigreset:
    permission: op
    trigger:
        clear {killPoints::*}
        clear {upgrades::*}

command /addpoints <number> <player>:
    permission: op
    trigger:
        add arg-1 to {killPoints::%uuid of arg-2%}

command /radio:
    trigger:
        if {radio::%uuid of player%} is 1:
            set {radio::%uuid of player%} to 0
            stop all sounds for player
            send "Radio is now &cOFF&f." to player
            stop
        if {radio::%uuid of player%} is 0:
            set {radio::%uuid of player%} to 1
        else if {radio::%uuid of player%} is not set:
            set {radio::%uuid of player%} to 1
        
        send "Radio is now &aON&f. To adjust song volume, change the 'Hostile' slider in sound settings" to player
        

command /discord:
    trigger:
        execute console command "/tellraw %player% {""bold"":true,""clickEvent"":{""action"":""open_url"",""value"":""https://discord.gg/TmJRtVk6Qk""},""color"":""light_purple"",""text"":""Click here to join the discord""}"


command /gamehelp:
    trigger:
        set {_inventory} to a chest inventory with 1 row named "Help"
        set slot 0 of {_inventory} to a black dye named "&6Guns become inaccurate when sprinting or jumping."
        set slot 1 of {_inventory} to a glass named "&6Most blocks can be destroyed. Weaker blocks like planks and glass can be shot through."
        set slot 2 of {_inventory} to a iron ingot named "&6Switch a gun to your offhand to reload."
        set slot 3 of {_inventory} to a lever named "&6Do /leavegame to leave a gamemode"
        set slot 4 of {_inventory} to a sculk named "&6Use /w <message> to whisper to players within 4 blocks of you."
        set slot 5 of {_inventory} to a gold ingot named "&6Use /class to switch classes when in a match. Use /shop to buy items in a match."
        set slot 6 of {_inventory} to a jukebox named "&6Use /togglehitding to toggle hit ding, or /sethitding <minecraft noise> to set it to something else!"
        open {_inventory} to player

command /leavegame:
    trigger:
        if {team::%uuid of player%} is "red":
            subtract 1 from {redPlayers}
        else if {team::%uuid of player%} is "blue":
            subtract 1 from {bluePlayers}
        toggle player's fastboard on
        set title of player's fastboard to "&e[Points]"
        set line 1 of player's fastboard to "&cKill Points - %{killPoints::%uuid of player%}%"
        clear {team::%uuid of player%}
        delete {team::%uuid of player%}
        clear player's inventory
        execute console command "/mv teleport %player% hub"
        wait 0.5 seconds
        set player's gamemode to adventure
        removeNoTag(player)
        heal player
        feed player

command /class:
    trigger:
        if {team::%uuid of player%} is set:
            set {_inventory} to a chest inventory with 3 row named "Select Loadout"
            set slot 2 of {_inventory} to a diamond named "Select Assault"
            set slot 6 of {_inventory} to a diamond named "Select Recon"
            set slot 4 of {_inventory} to a diamond named "Select Engineer"
            set slot 20 of {_inventory} to a diamond named "Select Support"
            set slot 22 of {_inventory} to a diamond named "Select Demolitionist"
            set slot 24 of {_inventory} to a barrier named "Coming Soon"
            open {_inventory} to player

command /w <text>:
    trigger:
        loop all players:
            if distance between loop-player and player <= 4:
                if loop-player is not player:
                    send "&7[Whisper] &f%player%: %arg%" to loop-player

command /start:
    trigger:
        if {team::%uuid of player%} is not set:
            set {_inventory} to a chest inventory with 3 row named "Select Loadout"
            set slot 2 of {_inventory} to a diamond named "&fAssault" with lore "&f- Offense based"
            set slot 6 of {_inventory} to a diamond named "&fRecon" with lore "&f- Focused on sniping"
            set slot 4 of {_inventory} to a diamond named "&fEngineer" with lore "&f- Building and traps"
            set slot 20 of {_inventory} to a diamond named "&fSupport" with lore "&f- Slow and powerful"
            set slot 22 of {_inventory} to a diamond named "&fDemolitionist" with lore "&f- Bombs"
            set slot 24 of {_inventory} to a barrier named "Coming Soon"
            open {_inventory} to player

command /killshop:
    trigger:
        if {team::%uuid of player%} is not set:
            set {_inventory} to a chest inventory with 3 row named "Points: %{killPoints::%uuid of player%}%"
            #set slot 10 of {_inventory} to a gold ingot named "&6Cash on Kill" with lore "&6Current value: $%{upgrades::%uuid of player%::killcash}%" and "&6Cost to Upgrade: %{upgrades::%uuid of player%::killcash}%p"
            set slot 11 of {_inventory} to a spyglass named "&6Unlock Recon" with lore "&640p"
            set slot 12 of {_inventory} to a pink dye named "&6Unlock Support" with lore "&640p"
            set slot 13 of {_inventory} to a green dye named "&6Unlock Demolitionist" with lore "&630p"
            set slot 14 of {_inventory} to a lime dye named "&6Unlock FAMAS" with lore "&615p"
            set slot 15 of {_inventory} to a orange dye named "&6Unlock Kriss Vector" with lore "&615p"
            open {_inventory} to player
    
on inventory click:
    set {_points} to {killPoints::%uuid of player%}
    set title of player's fastboard to "&e[Points]"
    set line 1 of player's fastboard to "&cKill Points - %{killPoints::%uuid of player%}%"

    if event-item is a gold ingot named "&6Cash on Kill":
        cancel event
        if {killPoints::%uuid of player%} >= {upgrades::%uuid of player%::killcash}:
            subtract {upgrades::%uuid of player%::killcash} from {killPoints::%uuid of player%}
            add 1 to {upgrades::%uuid of player%::killcash}
            set slot 10 of player's open inventory to a gold ingot named "&6Cash on Kill" with lore "&6Current value: $%{upgrades::%uuid of player%::killcash}%" and "&6Cost to Upgrade: %{upgrades::%uuid of player%::killcash}%p"
        else:
            send "&cYou don't have enough points to buy this!" to player
    
    if event-item is a spyglass named "&6Unlock Recon":
        cancel event
        if {killPoints::%uuid of player%} >= 40:
            if {upgrades::%uuid of player%::reconunlocked} is not set:
                subtract 40 from {killPoints::%uuid of player%}
                set {upgrades::%uuid of player%::reconunlocked} to true
            else:
                send "&aYou already have this upgrade!" to player
        else:
            send "&cYou don't have enough points to buy this!" to player

    if event-item is a pink dye named "&6Unlock Support":
        cancel event
        if {killPoints::%uuid of player%} >= 40:
            if {upgrades::%uuid of player%::supportunlocked} is not set:
                subtract 40 from {killPoints::%uuid of player%}
                set {upgrades::%uuid of player%::supportunlocked} to true
            else:
                send "&aYou already have this upgrade!" to player
        else:
            send "&cYou don't have enough points to buy this!" to player

    if event-item is a green dye named "&6Unlock Demolitionist":
        cancel event
        if {killPoints::%uuid of player%} >= 30:
            if {upgrades::%uuid of player%::demounlocked} is not set:
                subtract 30 from {killPoints::%uuid of player%}
                set {upgrades::%uuid of player%::demounlocked} to true
            else:
                send "&aYou already have this upgrade!" to player
        else:
            send "&cYou don't have enough points to buy this!" to player

    if event-item is a lime dye named "&6Unlock FAMAS":
        cancel event
        if {killPoints::%uuid of player%} >= 15:
            if {upgrades::%uuid of player%::famasunlocked} is not set:
                subtract 15 from {killPoints::%uuid of player%}
                set {upgrades::%uuid of player%::famasunlocked} to true
            else:
                send "&aYou already have this upgrade!" to player
        else:
            send "&cYou don't have enough points to buy this!" to player

    if event-item is a orange dye named "&6Unlock Kriss Vector":
        cancel event
        if {killPoints::%uuid of player%} >= 15:
            if {upgrades::%uuid of player%::vectorunlocked} is not set:
                subtract 15 from {killPoints::%uuid of player%}
                set {upgrades::%uuid of player%::vectorunlocked} to true
            else:
                send "&aYou already have this upgrade!" to player
        else:
            send "&cYou don't have enough points to buy this!" to player

        

            
    if name of event-inventory is "Points: %{_points}%":
        set name of player's current inventory to "Points: %{killPoints::%uuid of player%}%"


