                set slot 13 of {_inventory} to a snowball named "&fSmoke Grenade x1" with lore "$10"
                set slot 14 of {_inventory} to a flint and steel named "&fFlint and Steel x1" with lore "$10"
                set slot 15 of {_inventory} to a stone pressure plate named "&fPressure Plate x4" with lore "$10"
                set slot 16 of {_inventory} to a tnt named "&fTNT x4" with lore "$20"
