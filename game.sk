function joinGame(p: player):
    if {started} is false:
        startGame()
        startTimer()
    wait 1 tick
    setTeam({_p})
    addNoTag({_p})
    #execute console command "/mv teleport %{_p}% %{map}%2"
    wait 1.5 seconds
   
    respawnInGame({_p})
    wait 1 seconds
    send title "&f%{map}%" with subtitle "&f%{gameType}%" to {_p}
    send "&a&lREAD THE STUFF BELOW" to {_p}
    send "&6Switch a weapon to your offhand (press F) to reload!" to {_p}
    send "&6Run /class and /shop" to {_p}
    send "&6Get kills to earn points!" to {_p}
    send "&6Run /radio to toggle music." to {_p}
# Start and shop menus
on inventory click:
    if name of event-inventory is "Help":
        cancel event

on inventory click:
    set {_balance} to {cash::%uuid of player%}
    if event-item is diamond named "&fAssault": # event click
        cancel event
        if {team::%uuid of player%} is not set:
            set {cash::%uuid of player%} to 0
            close player's inventory
            set {nextloadout::%uuid of player%} to "assault"
            set {_inventory} to a chest inventory with 3 row named "Select Loadout"
            set slot 11 of {_inventory} to a black dye named "&fSelect M4A1"
            if {upgrades::%uuid of player%::famasunlocked} is true:
                set slot 13 of {_inventory} to a lime dye named "&fSelect FAMAS"
            if {upgrades::%uuid of player%::vectorunlocked} is true:
                set slot 15 of {_inventory} to a orange dye named "&fSelect Kriss Vector"
            open {_inventory} to player

    if event-item is a black dye named "&fSelect M4A1":
        cancel event
        close player's inventory
        set {mainweapon::%uuid of player%} to "M4A1"
        if {team::%uuid of player%} is not set:
            joinGame(player)

    if event-item is a lime dye named "&fSelect FAMAS":
        cancel event
        close player's inventory
        set {mainweapon::%uuid of player%} to "FAMAS"
        if {team::%uuid of player%} is not set:
            joinGame(player)

    if event-item is a orange dye named "&fSelect Kriss Vector":
        cancel event
        close player's inventory
        set {mainweapon::%uuid of player%} to "Vector"
        if {team::%uuid of player%} is not set:
            joinGame(player)

    if event-item is diamond named "&fRecon": # event click
        cancel event
        if {upgrades::%uuid of player%::reconunlocked} is true:
            if {team::%uuid of player%} is not set:
                set {cash::%uuid of player%} to 0
                close player's inventory
                set {nextloadout::%uuid of player%} to "recon"
                joinGame(player)
        else:
            send "&cUnlock this class in the shop!" to player

    if event-item is diamond named "&fEngineer": # event click
        cancel event
        if {team::%uuid of player%} is not set:
            set {cash::%uuid of player%} to 0
            close player's inventory
            set {nextloadout::%uuid of player%} to "engineer"
            joinGame(player)

    if event-item is diamond named "&fSupport": # event click
        cancel event
        if {upgrades::%uuid of player%::supportunlocked} is true:
            if {team::%uuid of player%} is not set:
                set {cash::%uuid of player%} to 0
                close player's inventory
                set {nextloadout::%uuid of player%} to "support"
                joinGame(player)

        else:
            send "&cUnlock this class in the shop!" to player
        
    if event-item is diamond named "&fDemolitionist": # event click
        cancel event
        if {upgrades::%uuid of player%::demounlocked} is true:
            if {team::%uuid of player%} is not set:
                set {cash::%uuid of player%} to 0
                close player's inventory
                set {nextloadout::%uuid of player%} to "demo"
                joinGame(player)
        else:
            send "&cUnlock this class in the shop!" to player

    if event-item is diamond named "Select Assault":
        cancel event
        close player's inventory
        set {nextloadout::%uuid of player%} to "assault"
        set {_inventory} to a chest inventory with 3 row named "Select Loadout"
        set {mainweapon::%uuid of player%} to "M4A1"
        set slot 11 of {_inventory} to a black dye named "&fSelect M4A1"
        set slot 13 of {_inventory} to a lime dye named "&fSelect FAMAS"
        set slot 15 of {_inventory} to a orange dye named "&fSelect Kriss Vector"
        open {_inventory} to player

    if event-item is diamond named "Select Recon":
        cancel event
        if {upgrades::%uuid of player%::reconunlocked} is true:
            close player's inventory
            set {nextloadout::%uuid of player%} to "recon"
        else:
            send "&cUnlock this class in the shop!" to player

    if event-item is diamond named "Select Engineer":
        cancel event
        close player's inventory
        set {lnextoadout::%uuid of player%} to "engineer"

    if event-item is diamond named "Select Support":
        cancel event
        if {upgrades::%uuid of player%::supportunlocked} is true:
            close player's inventory
            set {nextloadout::%uuid of player%} to "support"
        else:
            send "&cUnlock this class in the shop!" to player
        
    if event-item is diamond named "Select Demolitionist":
        cancel event
        if {upgrades::%uuid of player%::demounlocked} is true:
            close player's inventory
            set {nextloadout::%uuid of player%} to "demo"
        else:
            send "&cUnlock this class in the shop!" to player

    if event-item is a barrier:
        cancel event

    if event-item is a iron ingot named "&fM4A1 Mags x2":
        cancel event
        if {cash::%uuid of player%} >= 10:
            give 2 iron ingot named "M4A1 Mag" to player
            add -10 to {cash::%uuid of player%}

    if event-item is a iron ingot named "&fGlock Mags x2":
        cancel event
        if {cash::%uuid of player%} >= 5:
            give 2 iron ingot named "Glock Mag" to player
            add -5 to {cash::%uuid of player%}

    if event-item is a cooked beef named "&fSteak x4":
        cancel event
        if {cash::%uuid of player%} >= 10:
            give 4 cooked beef named "Steak" to player
            add -10 to {cash::%uuid of player%}

    if event-item is a egg named "&fGrenade x1":
        cancel event
        if {cash::%uuid of player%} >= 10:
            give egg named "Grenade" to player
            add -10 to {cash::%uuid of player%}

    if event-item is a snowball named "&fSmoke Grenade x1":
        cancel event
        if {cash::%uuid of player%} >= 10:
            give snowball named "Smoke Grenade" to player
            add -10 to {cash::%uuid of player%}

    if event-item is a potion of speed named "&fSpeed Potion x1":
        cancel event
        if {cash::%uuid of player%} >= 20:
            give potion of speed to player
            add -20 to {cash::%uuid of player%}

    if event-item is a yellow dye named "&fDash Ability":
        cancel event
        if {cash::%uuid of player%} >= 30:
            give yellow dye named "Dash" to player
            add -30 to {cash::%uuid of player%}

    if event-item is a ladder named "&fLadder x16":
        cancel event
        if {cash::%uuid of player%} >= 30:
            give 16 ladder to player
            add -20 to {cash::%uuid of player%}

    if event-item is a flint and steel named "&fFlint and Steel x1":
        cancel event
        if {cash::%uuid of player%} >= 10:
            give flint and steel to player
            add -10 to {cash::%uuid of player%}

    if event-item is a stone pressure plate named "&fPressure Plate x4":
        cancel event
        if {cash::%uuid of player%} >= 10:
            give 4 stone pressure plate to player
            add -10 to {cash::%uuid of player%}

    if event-item is a tnt named "&fTNT x4":
        cancel event
        if {cash::%uuid of player%} >= 20:
            give 4 tnt to player
            add -20 to {cash::%uuid of player%}
    
    if event-item is a iron ingot named "&fMinigun Chain x1":
        cancel event
        if {cash::%uuid of player%} >= 10:
            give iron ingot named "Minigun Chain" to player
            add -10 to {cash::%uuid of player%}



    if name of event-inventory is "Balance: $%{_balance}%":
        set name of player's current inventory to "Balance: $%{cash::%uuid of player%}%"

on death of player:
    if {team::%uuid of attacker%} is set:
        if {gameType} is "team":
            if attacker is not victim:
                if {team::%uuid of attacker%} is not {team::%uuid of victim%}:
                    add 1 to {killPoints::%uuid of attacker%}
                    add {upgrades::%uuid of attacker%::killcash} to {cash::%uuid of attacker%}
                    send "&aKill +$%{upgrades::%uuid of attacker%::killcash}%" to attacker
                    if {team::%uuid of victim%} = "red":
                        add 1 to {bluePoints}
                    else if {team::%uuid of victim%} = "blue":
                        add 1 to {redPoints}
                #removeNoTag(victim)
                loop all players:
                    if {team::%uuid of loop-player%} is set:
                        set title of loop-player's fastboard to "&e[Team Scores]"
                        set line 1 of loop-player's fastboard to "&cRed Team - %{redPoints}%"
                        set line 2 of loop-player's fastboard to "&bBlue Team - %{bluePoints}%"
            
        if {gameType} is "ffa":
            if attacker is a player:
                if attacker is not victim:
                    add 1 to {killPoints::%uuid of attacker%}
                    add {upgrades::%uuid of attacker%::killcash} to {cash::%uuid of attacker%}
                    send "&aKill +$%{upgrades::%uuid of attacker%::killcash}%" to attacker


on respawn:
    if {gameType} is "team":
        if {team::%uuid of player%} is "red":
            wait 5 ticks
            respawnInGame(player)
        if {team::%uuid of player%} is "blue":
            wait 5 ticks
            respawnInGame(player)
    else if {gameType} is "ffa":
        if {team::%uuid of player%} is set:
            wait 5 ticks
            respawnInGame(player)
