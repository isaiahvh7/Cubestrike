
on load:
    make console execute "/team add NoTag"
    make console execute "/team modify NoTag nametagVisibility never"

function addNoTag(player: player):
    make console execute "/team join NoTag %{_player}%"

function removeNoTag(player: player):
    make console execute "/team leave %{_player}%"

function startTimer():
    wait 4 seconds
    #broadcast "&6&lToggle game timer with /toggletimer"
    broadcast "&c&l10 Minutes Remaining"
    set {gameTime} to 600
    set {bar} to boss bar with id "bbar1" with title "Game Time"
    set bar style of {bar} to solid bar
    loop all players:
        if {team::%uuid of loop-player%} is set:
            #add loop-player to {bar}
            set {bar::%uuid of loop-player%} to true


function setTeam(p: player):
    wait 2 ticks
    if {gameType} is "team":
        if {redPlayers} is greater than {bluePlayers}:
            set {team::%uuid of {_p}%} to "blue"
            add 1 to {bluePlayers}
        else if {bluePlayers} is greater than {redPlayers}:
            set {team::%uuid of {_p}%} to "red"
            add 1 to {redPlayers}
        else:
            set {_r} to random integer between 0 and 1
            if {_r} is 0:
                set {team::%uuid of {_p}%} to "blue"
                add 1 to {bluePlayers}
            else:
                set {team::%uuid of {_p}%} to "red"
                add 1 to {redPlayers}

    else if {gameType} is "ffa":
        set {team::%uuid of {_p}%} to random integer between 1 and 10000

function respawnInGame(p: player):
    set {loadout::%uuid of {_p}%} to {nextloadout::%uuid of {_p}%}
    if {gameType} is "team":
        toggle fastboard of {_p} on
        set title of {_p}'s fastboard to "&e[Team Scores]"
        set line 1 of {_p}'s fastboard to "&cRed Team - %{redPoints}%"
        set line 2 of {_p}'s fastboard to "&bBlue Team - %{bluePoints}%"
    if {gameType} is "ffa":
        toggle fastboard of {_p} off
    if {gameType} is "team":
        if {team::%uuid of {_p}%} is "red":
            if {map} is "pineriver":
                set {_x} to random integer between 487 and 500
                set {_z} to random integer between -78 and 0
                teleport {_p} to location({_x}, 25, {_z}, world "%{map}%2")
            else if {map} is "towny":
                teleport {_p} to location(-121, 63, 84, world "%{map}%2")
            else if {map} is "trenches":
                teleport {_p} to location(12.5, -58, 10, world "%{map}%2")
            else if {map} is "lodge":
                teleport {_p} to location(201.5, -51, 292.5, world "%{map}%2")
        else if {team::%uuid of {_p}%} is "blue":
            if {map} is "pineriver":
                set {_x} to random integer between 199 and 198
                set {_z} to random integer between -20 and -21
                teleport {_p} to location({_x}, 24, {_z}, world "%{map}%2")
            else if {map} is "towny":
                teleport {_p} to location(-238, 64, 0, world "%{map}%2")
            else if {map} is "trenches":
                teleport {_p} to location(65.5, -58, 116.5, world "%{map}%2")
            else if {map} is "lodge":
                teleport {_p} to location(295.5, -42, 143.5, world "%{map}%2")
        wait 5 ticks
        if {team::%uuid of {_p}%} is "red":
            set {_item} to unbreakable leather helmet
            dye {_item} red
            #set helmet of {_p} to {_item}
        else if {team::%uuid of {_p}%} is "blue":
            set {_item} to unbreakable leather helmet
            dye {_item} blue
            #set helmet of {_p} to {_item}
    
    if {gameType} is "ffa":
        if {map} is "pineriver":
            if {pineLocs::*} is not set:
                set {pineLocs::*} to location(486, 23, -159, world "%{map}%2"), location(391, 24, -152, world "%{map}%2"), location(245, 23, -134, world "%{map}%2"), location(359, 19, 93, world "%{map}%2"), location(419, 22, 45, world "%{map}%2"), location(243, 21, 40, world "%{map}%2"), location(315, 23, -137, world "%{map}%2")
            #if size of {pineLocs::*} is less than 1:
            #    set {pineLocs::*} to location(486, 23, -159, world "%{map}%2"), location(391, 24, -152, world "%{map}%2"), location(245, 23, -134, world "%{map}%2"), location(359, 19, 93, world "%{map}%2"), location(419, 22, 45, world "%{map}%2"), location(243, 21, 40, world "%{map}%2"), location(315, 23, -137, world "%{map}%2")
            set {_spawnLoc} to a random element out of {pineLocs::*}
            remove {_spawnLoc} from {pineLocs::*}
            teleport {_p} to {_spawnLoc}

        else if {map} is "towny":
            if {townyLocs::*} is not set:
                set {townyLocs::*} to location(-110, 64, 79, world "%{map}%2"), location(-116, 64, 6, world "%{map}%2"), location(-166, 63, -33, world "%{map}%2"), location(-236, 64, -26, world "%{map}%2"), location(-242, 63, 29, world "%{map}%2"), location(-174, 63, 77, world "%{map}%2"), location(-120, 69, -16, world "%{map}%2")
            #if size of {townyLocs::*} is less than 1:
            #    set {townyLocs::*} to location(-110, 64, 79, world "%{map}%2"), location(-116, 64, 6, world "%{map}%2"), location(-166, 63, -33, world "%{map}%2"), location(-236, 64, -26, world "%{map}%2"), location(-242, 63, 29, world "%{map}%2"), location(-174, 63, 77, world "%{map}%2"), location(-120, 69, -16, world "%{map}%2")
            set {_spawnLoc} to a random element out of {townyLocs::*}
            remove {_spawnLoc} from {townyLocs::*}
            teleport {_p} to {_spawnLoc}

        else if {map} is "trenches":
            if {trenchesLocs::*} is not set:
                set {trenchesLocs::*} to location(18, -57, -18, world "%{map}%2"), location(49, -57, -20, world "%{map}%2"), location(91, -58, 96, world "%{map}%2"), location(29, -58, 102, world "%{map}%2"), location(-35, -56, 98, world "%{map}%2"), location(-23, -57, 43, world "%{map}%2"), location(66, -57.5, 44, world "%{map}%2")
            #if size of {townyLocs::*} is less than 1:
            #    set {townyLocs::*} to location(-110, 64, 79, world "%{map}%2"), location(-116, 64, 6, world "%{map}%2"), location(-166, 63, -33, world "%{map}%2"), location(-236, 64, -26, world "%{map}%2"), location(-242, 63, 29, world "%{map}%2"), location(-174, 63, 77, world "%{map}%2"), location(-120, 69, -16, world "%{map}%2")
            set {_spawnLoc} to a random element out of {trenchesLocs::*}
            remove {_spawnLoc} from {trenchesLocs::*}
            teleport {_p} to {_spawnLoc}

        else if {map} is "lodge":
            if {lodgeLocs::*} is not set:
                # Old Locations
                #set {lodgeLocs::*} to location(178, -56, 251, world "%{map}%2"), location(233, -47, 315, world "%{map}%2"), location(306, -46, 285, world "%{map}%2"), location(297, -42, 139, world "%{map}%2")
                #New Locations
                set {lodgeLocs::*} to location(265, -55, 207, world "%{map}%2"), location(253, -55, 237, world "%{map}%2"), location(214, -52, 161, world "%{map}%2"), location(255, -57, 167, world "%{map}%2"), location(234.5, -23.5, 173, world "%{map}%2"), location(220.5, -27.5, 236.5, world "%{map}%2")

                #if size of {townyLocs::*} is less than 1:
            #    set {townyLocs::*} to location(-110, 64, 79, world "%{map}%2"), location(-116, 64, 6, world "%{map}%2"), location(-166, 63, -33, world "%{map}%2"), location(-236, 64, -26, world "%{map}%2"), location(-242, 63, 29, world "%{map}%2"), location(-174, 63, 77, world "%{map}%2"), location(-120, 69, -16, world "%{map}%2")
            set {_spawnLoc} to a random element out of {lodgeLocs::*}
            remove {_spawnLoc} from {lodgeLocs::*}
            teleport {_p} to {_spawnLoc}

    wait 0.2 second
    set {glockAmmo::%uuid of {_p}%} to 10
    set {m4Ammo::%uuid of {_p}%} to 30
    set {ltrAmmo::%uuid of {_p}%} to 5
    set {miniAmmo::%uuid of {_p}%} to 50
    set {grenadeAmmo::%uuid of {_p}%} to 8
    set {famasAmmo::%uuid of {_p}%} to 20
    set {krissAmmo::%uuid of {_p}%} to 20
    
    heal {_p}
    feed {_p}
    if {loadout::%uuid of {_p}%} is "assault":
        clear {_p}'s inventory
        set {_inventory} to {_p}'s inventory
        set slot 1 of {_inventory} to red dye named "Glock" with lore "&fAmmo: 10", "&fF or offhand to reload"
        set slot 8 of {_inventory} to 4 iron ingot named "Glock Mag"
        set slot 2 of {_inventory} to 1 snowball named "Smoke Grenade"
        set slot 3 of {_inventory} to 3 egg named "Grenade"
        set slot 4 of {_inventory} to wooden pickaxe
        set slot 5 of {_inventory} to 12 cooked beef
        set slot 6 of {_inventory} to {_item}
        if {mainweapon::%uuid of {_p}%} is "M4A1":
            set slot 0 of {_inventory} to black dye named "M4A1" with lore "&fAmmo: 30", "&fF or offhand to reload"
            set slot 7 of {_inventory} to 10 iron ingot named "M4A1 Mag"
        else if {mainweapon::%uuid of {_p}%} is "FAMAS":
            set slot 0 of {_inventory} to lime dye named "FAMAS" with lore "&fAmmo: 20", "&fF or offhand to reload"
            set slot 7 of {_inventory} to 10 iron ingot named "FAMAS Mag"
        else if {mainweapon::%uuid of {_p}%} is "Vector":
            set slot 0 of {_inventory} to orange dye named "Kriss Vector" with lore "&fAmmo: 20", "&fF or offhand to reload"
            set slot 7 of {_inventory} to 12 iron ingot named "Vector Mag"
        #set {_p}'s inventory to {_inventory}

    if {loadout::%uuid of {_p}%} is "recon":
        clear {_p}'s inventory
        set {_inventory} to {_p}'s inventory
        set slot 0 of {_inventory} to spyglass named "L30 LTR" with lore "&fAmmo: 5", "&fLeft click to reload", "&fF or offhand to shoot"
        set slot 7 of {_inventory} to 8 iron ingot named "L30 Mag"
        set slot 1 of {_inventory} to red dye named "Glock"
        set slot 8 of {_inventory} to 3 iron ingot named "Glock Mag"
        set slot 2 of {_inventory} to 1 snowball named "Smoke Grenade"
        set slot 3 of {_inventory} to yellow dye named "Dash"
        set slot 4 of {_inventory} to 12 cooked beef
        set slot 5 of {_inventory} to {_item}
        #set {_p}'s inventory to {_inventory}

    if {loadout::%uuid of {_p}%} is "engineer":
        clear {_p}'s inventory
        set {_inventory} to {_p}'s inventory
        set slot 0 of {_inventory} to black dye named "M4A1" with lore "&fAmmo: 30", "&fF or offhand to reload"
        set slot 8 of {_inventory} to 16 iron ingot named "M4A1 Mag"
        set slot 1 of {_inventory} to 3 egg named "Grenade"
        set slot 2 of {_inventory} to 32 oak planks
        set slot 3 of {_inventory} to 24 cooked beef
        set slot 4 of {_inventory} to {_item}
        #set {_p}'s inventory to {_inventory}

    if {loadout::%uuid of {_p}%} is "support":
        clear {_p}'s inventory
        set {_inventory} to {_p}'s inventory
        set slot 0 of {_inventory} to pink dye named "Minigun" with lore "&fAmmo: 50", "&fF or offhand to reload"
        set slot 8 of {_inventory} to 4 iron ingot named "Minigun Chain"
        set slot 1 of {_inventory} to 3 egg named "Grenade"
        set slot 2 of {_inventory} to 8 oak planks
        set slot 3 of {_inventory} to 24 cooked beef
        set slot 4 of {_inventory} to {_item}
        #set {_p}'s inventory to {_inventory}

    if {loadout::%uuid of {_p}%} is "demo":
        clear {_p}'s inventory
        set {_inventory} to {_p}'s inventory
        set slot 0 of {_inventory} to green dye named "Grenade Launcher" with lore "&fAmmo: 8", "&fF or offhand to reload"
        set slot 7 of {_inventory} to 8 iron ingot named "Grenade Mag"
        set slot 1 of {_inventory} to red dye named "Glock"
        set slot 8 of {_inventory} to 3 iron ingot named "Glock Mag"
        set slot 2 of {_inventory} to 1 snowball named "Smoke Grenade"
        set slot 3 of {_inventory} to 12 cooked beef
        set slot 5 of {_inventory} to {_item}
        #set {_p}'s inventory to {_inventory}

function startGame():
    clear {team::*}
    clear {breakStage::*}
    set {redPlayers} to 0
    set {bluePlayers} to 0
    set {redPoints} to 0
    set {bluePoints} to 0
    set {started} to true
    set {_r} to random integer from 0 to 2
    clear {pineLocs::*}
    clear {townyLocs::*}
    clear {trenchesLocs::*}
    clear {lodgeLocs::*}
    delete {pineLocs}
    delete {townyLocs}
    delete {trenchesLocs}
    delete {lodgeLocs}
    if {maps::*} is not set:
        set {maps::*} to "pineriver", "towny", "trenches", "lodge"
    set {map} to random element out of {maps::*}
    remove {map} from {maps::*}
    if online player count > 3:
        set {_r} to random integer from 0 to 2
        if {_r} is 0:
            set {gameType} to "ffa"
        else:
            set {gameType} to "team"
    else:
        set {gameType} to "ffa"
    execute console command "/mv clone %{map}% %{map}%2"
    wait 20 ticks
    set {_time} to a random integer between 0 and 24000
    set {_t} to "%{_time}% ticks"
    set {_tim} to {_t} parsed as timespan
    if {map} is not "lodge":
        set time of world "%{map}%2" to {_tim}
    else:
        set weather of "%{map}%2" to rainy
    # Show to all players

    if {gameType} is "ffa":
        execute console command "/scoreboard objectives add kills playerKillCount ""Kills"""
        execute console command "/scoreboard objectives setdisplay sidebar kills"

    clear {kills::*}


function crack(strength: number, block: block):
    if {breakStage::%location of {_block}%} is not set:
        set {breakStage::%location of {_block}%} to 0
    add {_strength} to {breakStage::%location of {_block}%}
    if {breakStage::%location of {_block}%} >= 1:
        break {_block}
        set {breakStage::%location of {_block}%} to 0
    else:
        make all players see damage of {_block} as {breakStage::%location of {_block}%} by random integer between 1 and 100000

function pierceParticles(block: block, dir: vector, loc: location):
    add -0.5 to vector length of {_dir}
    set {_temp} to {_loc} offset by {_dir}
    draw 6 of block using (type of {_block}) at {_temp}
    draw dust particle using dustOption(rgb(0, 0, 0), 1) at {_temp}
    add 1 to vector length of {_dir}
    set {_temp} to {_loc} offset by {_dir}
    draw 6 of block using (type of {_block}) at {_temp}
    draw dust particle using dustOption(rgb(0, 0, 0), 1) at {_temp}
    

function shoot(p: player, range: number, pierce: number, damage: number, vertspread: number, horizspread: number, sniper: number) :: location:
    set {_loc} to location of {_p}'s eye
    add -0 to y-coordinate of {_loc}
    set {_dir} to normalized vector from yaw {_p}'s yaw and pitch {_p}'s pitch
    set vector length of {_dir} to 0.01
    set {_randpitch} to random number between ({_vertspread}*-1) and {_vertspread}
    set {_randyaw} to random number between ({_horizpread}*-1) and {_horizspread}
    set {_r1} to random number from -1.5 and 1.5
    set {_r2} to random integer from -1.5 and 1.5
    if {_p} is crouching:
        set {_randpitch} to {_randpitch} / 2
        set {_randyaw} to {_randyaw} / 2
    if {_p} is sprinting:
        add random number between 0 and {_sniper} to {_randpitch}
        add random number between 0 and {_sniper} to {_randyaw}
        set {_randpitch} to {_randpitch} + {_r1}
        set {_randyaw} to {_randyaw} + {_r2}
    if {_p} is not on ground:
        add random number between 0 and {_sniper} to {_randpitch}
        add random number between 0 and {_sniper} to {_randyaw}
        set {_randpitch} to {_randpitch} + {_r1}
        set {_randyaw} to {_randyaw} + {_r2}
    add {_randpitch} to pitch of {_dir}
    add {_randyaw} to yaw of {_dir}

    set {_hitGun::!!} to 1
    set {_whoosh::!!} to 1
    set {_pierced} to 0
    loop ({_range}*2) times:

        set {_tempLoc} to {_loc} offset by {_dir}
        set {_block} to block at {_tempLoc}

        if {_pierced} >= {_pierce}:
            add -0.25 to vector length of {_dir}
            set {_tempLoc} to {_loc} offset by {_dir}
            return {_tempLoc}

        #draw dust particle using dustOption(rgb(255, 251, 0, 1), 0.1) at {_tempLoc}
        #morkazsk spawn 1 of particle "FLAME" for player at {_tempLoc}
        draw 1 of dust using dustOption(rgb(255, 251, 0, 1), 0.1) at {_tempLoc} for all players
        #set {_color} to Color.fromRGB(255,251,0)
        #set {_dust} to new DustOptions({_color}, 0.1)
        #{_p}.spawnParticle(Particle.REDSTONE,{_tempLoc},0,0,0,0,0,{_dust})
        if {_block} is not air:
            set {_type} to "%type of {_block}%"
            if {_hitGun::*} contains location of {_block}:
                #nothing

            else if {_type} contains "glass":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                play sound "minecraft:block.glass.break" at {_temploc}
                pierceParticles({_block}, {_dir}, {_loc})
                crack(0.5, {_block})
                
                add 1 to {_pierced}
                add location of {_block} to {_hitGun::*}

            else if {_type} contains "planks":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}


                add location of {_block} to {_hitGun::*}
                if {breakStage::%location of {_block}%} > 0.5:
                    pierceParticles({_block}, {_dir}, {_loc})
                    crack(0.1, {_block})
                    add 1 to {_pierced}
                else:
                    crack(0.1, {_block})
                    add -0.25 to vector length of {_dir}
                    set {_back} to {_loc} offset by {_dir}
                    draw 6 of block using (type of {_block}) at {_back}
                    return {_back}

            else if {_type} contains "log":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                add location of {_block} to {_hitGun::*}
                crack(0.1, {_block})
                add -0.25 to vector length of {_dir}
                set {_back} to {_loc} offset by {_dir}
                draw 6 of block using (type of {_block}) at {_back}
                return {_back}
            
            else if {_type} contains "wood":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}


                add location of {_block} to {_hitGun::*}
                if {breakStage::%location of {_block}%} > 0.5:
                    pierceParticles({_block}, {_dir}, {_loc})
                    crack(0.1, {_block})
                    add 1 to {_pierced}
                else:
                    crack(0.1, {_block})
                    add -0.5 to vector length of {_dir}
                    set {_back} to {_loc} offset by {_dir}
                    draw 6 of block using (type of {_block}) at {_back}
                    return {_back}
                

            else if {_type} contains "terracotta":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                add location of {_block} to {_hitGun::*}
                crack(0.2, {_block})
                add -0.25 to vector length of {_dir}
                set {_back} to {_loc} offset by {_dir}
                draw 6 of block using (type of {_block}) at {_back}
                return {_back}

            else if {_type} contains "stairs":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                add location of {_block} to {_hitGun::*}
                crack(0.2, {_block})
                add -0.25 to vector length of {_dir}
                set {_back} to {_loc} offset by {_dir}
                draw 6 of block using (type of {_block}) at {_back}
                return {_back}

            else if {_type} contains "mushroom":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                pierceParticles({_block}, {_dir}, {_loc})
                crack(0.5, {_block})
                
                add 1 to {_pierced}
                add location of {_block} to {_hitGun::*}
            
            else if {_type} contains "wool":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                pierceParticles({_block}, {_dir}, {_loc})
                crack(0.5, {_block})
                
                add 1 to {_pierced}
                add location of {_block} to {_hitGun::*}
            
            else if {_type} contains "sign":
                play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                pierceParticles({_block}, {_dir}, {_loc})
                crack(0.5, {_block})
                
                add 1 to {_pierced}
                add location of {_block} to {_hitGun::*}

            
            else if {_type} contains "slab":
                #play sound "minecraft:bulletimpact" with volume 0.8 at {_tempLoc}
                #pierceParticles({_block}, {_dir}, {_loc})
                #crack(0.2, {_block})
                
                #add 1 to {_pierced}
                #add location of {_block} to {_hitGun::*}

            else if {_type} is "iron bars":
                #continue
            else if {_type} is "player head":
                #continue
            else if {_type} contains "peony":
                #continue
            else if {_type} contains "snow":
                #continue
            else if {_type} contains "banner":
                #continue
            else if {_type} contains "rail":
                #continue
            else if {_type} contains "fern":
                #continue
            else if {_type} contains "lantern":
                #continue
            else if {_type} contains "lilac":
                #continue
            else if {_type} contains "rose":
                #continue
            else if {_type} contains "button":
                #continue
            else if {_type} contains "carpet":
                #continue
            else if {_type} contains "fence":
                #continue
            else if {_type} contains "sugar":
                #continue
            else if {_type} contains "vine":
                #continue
            else if {_type} contains "scaffolding":
                #continue
            else if {_type} is "tall grass":
                #continue
            else if {_type} is "short grass":
                #continue

            else if {_type} contains "door":
                play sound "minecraft:block.wood.break" at {_tempLoc}
            
            else if {_type} contains "torch":
                #continue
            
            else if {_type} contains "leaves":
                play sound "minecraft:block.azalea_leaves.break" at {_tempLoc}
            
            else if {_type} contains "water":
                # do nothing
            else if {_type} contains "plate":
                # do nothing
            

            else:
                add -0.25 to vector length of {_dir}
                set {_back} to {_loc} offset by {_dir}
                
                #particles
                draw 6 of block using (type of {_block}) at {_back}

                #sounds
                play sound "minecraft:bulletimpact" with volume 0.8 at {_back}


                return {_back}

        loop all living entities in radius 5 of {_tempLoc}:
            set {_entity} to loop-entity
            if {_entity} is {_p}:
                continue
            if {_whoosh::*} does not contain {_entity}'s uuid:
                set {_r} to random integer from 1 to 3
                if {_r} is 1:
                    play sound "minecraft:bulletwhoosh1" with volume 1.2 at {_tempLoc} for {_entity}
                if {_r} is 2:
                    play sound "minecraft:bulletwhoosh2" with volume 1.2 at {_tempLoc} for {_entity}
                if {_r} is 3:
                    play sound "minecraft:bulletwhoosh3" with volume 1.2 at {_tempLoc} for {_entity}
                add {_entity}'s uuid to {_whoosh::*}
###
            set {_etloc} to location of {_entity}
            add 1 to y-coordinate of {_etloc}
            if distance between {_etloc} and {_tempLoc} is smaller than 1:
###
            set {_px} to x-coordinate of {_tempLoc}
            set {_py} to y-coordinate of {_tempLoc}
            set {_pz} to z-coordinate of {_tempLoc}

            set {_handle} to {_entity}.getHandle()
            set {_aabb} to {_handle}.getBoundingBox()
            
            set {_ex} to 0.15
            set {_expandedMinX} to {_aabb}.minX - {_ex}
            set {_expandedMinY} to {_aabb}.minY - {_ex}
            set {_expandedMinZ} to {_aabb}.minZ - {_ex}
            set {_expandedMaxX} to {_aabb}.maxX + {_ex}
            set {_expandedMaxY} to {_aabb}.maxY + {_ex}
            set {_expandedMaxZ} to {_aabb}.maxZ + {_ex}

            if {_px} >= {_expandedMinX}:
                if {_px} <= {_expandedMaxX}:
                    if {_py} >= {_expandedMinY}:
                        if {_py} <= {_expandedMaxY}:
                            if {_pz} >= {_expandedMinZ}:
                                if {_pz} <= {_expandedMaxZ}:
                                    if {_hitGun::*} does not contain {_entity}'s uuid:
                                        
                                        #send "Hit" to {_p}
                                        #broadcast "dmg?"
                                        #{_entity}.setNoDamageTicks(0)
                                        #{_entity}.damage({_damage}, {_p})
                                        set the invincibility time span of {_entity} to 0 ticks
                                        make {_p} damage {_entity} by {_damage}
                                        add 1 to {_pierced}

                                        add {_entity}'s uuid to {_hitGun::*}

        add 0.25 to vector length of {_dir}
        

function updateCracks():
    loop {breakStage::*}:
        continue


function recoil(p: player, cooldown: string):
    #wait 1 tick
    set {_then} to {lastRightClick::%uuid of {_p}%}
    set {_cd} to {_cooldown} parsed as timespan
    if difference between {_then} and now > {_cd}:
        play hurt animation on {_p} with yaw 180
    #play hurt by explosion on {_p}
###
    set {_horiz} to random number from ({_horizkb}*-1) to {_horizkb}
    add ({_vertkb}) to pitch of {_p}
    wait 1 tick
    add ({_horiz}) to yaw of {_p}
    wait 4 tick
    subtract ({_vertkb}) from pitch of {_p}
    wait 1 tick
    subtract ({_hotiz}) from yaw of {_p}
###

function endGame():
    set {cash::*} to 0
    toggle fastboard of all players on
    if {gameType} is "team":
        if {redPoints} > {bluePoints}:
            set {started} to false
            send title "&cRed Wins!" to all players
            loop all players:
                removeNoTag(loop-player)
                delete {team::%uuid of loop-player%}
            # Show to all players
            clear {breakStage::*}
            clear {team::*}
            set {redPlayers} to 0
            set {bluePlayers} to 0
            set {redPoints} to 0
            set {bluePoints} to 0
            set {started} to false
            loop all players:
                set title of loop-player's fastboard to "&e[Points]"
                set line 1 of loop-player's fastboard to "&cKill Points - %{killPoints::%uuid of loop-player%}%"
                set loop-player's gamemode to adventure
                clear loop-player's inventory
                execute console command "/mv teleport %loop-player% hub"
        
            wait 1 second
            execute console command "/mv delete %{map}%2 --remove-players"
            set gamemode of all players to adventure

        else if {bluePoints} > {redPoints}:
            set {started} to false
            send title "&bBlue Wins!" to all players
            loop all players:
                removeNoTag(loop-player)
                delete {team::%uuid of loop-player%}
            # Show to all players
            clear {breakStage::*}
            clear {team::*}
            set {redPlayers} to 0
            set {bluePlayers} to 0
            set {redPoints} to 0
            set {bluePoints} to 0
            set {started} to false
            loop all players:
                set title of loop-player's fastboard to "&e[Points]"
                set line 1 of loop-player's fastboard to "&cKill Points - %{killPoints::%uuid of loop-player%}%"
                set loop-player's gamemode to adventure
                clear loop-player's inventory
                execute console command "/mv teleport %loop-player% hub"
            wait 1 second
            execute console command "/mv delete %{map}%2 --remove-players"
            set gamemode of all players to adventure

        else:
            set {started} to false
            send title "&7Game Tie!" to all players
            loop all players:
                removeNoTag(loop-player)
                delete {team::%uuid of loop-player%}
            # Show to all players
            clear {breakStage::*}
            clear {team::*}
            set {redPlayers} to 0
            set {bluePlayers} to 0
            set {redPoints} to 0
            set {bluePoints} to 0
            set {started} to false
            loop all players:
                set title of loop-player's fastboard to "&e[Points]"
                set line 1 of loop-player's fastboard to "&cKill Points - %{killPoints::%uuid of loop-player%}%"
                set loop-player's gamemode to adventure
                clear loop-player's inventory
                execute console command "/mv teleport %loop-player% hub"
            wait 1 second
            execute console command "/mv delete %{map}%2 --remove-players"
            set gamemode of all players to adventure
    
    else if {gameType} is "ffa":
        set {started} to false
        delete {gameType}
        send title "&cGame Over!" to all players
        loop all players:
            removeNoTag(loop-player)
            delete {team::%uuid of loop-player%}
        # Show to all players
        clear {breakStage::*}
        clear {team::*}
        set {redPlayers} to 0
        set {bluePlayers} to 0
        set {redPoints} to 0
        set {bluePoints} to 0
        set {started} to false
        loop all players:
            set title of loop-player's fastboard to "&e[Points]"
            set line 1 of loop-player's fastboard to "&cKill Points - %{killPoints::%uuid of loop-player%}%"
            clear loop-player's inventory
            execute console command "/mv teleport %loop-player% hub"
        
        wait 0.5 second
        execute console command "/mv delete %{map}%2 --remove-players"
        execute console command "/scoreboard objectives remove kills"
        set gamemode of all players to adventure

## GUNS

# Glock
on right click:
    if player is holding a red dye:
        if {reload::%uuid of player%} is set:
            if difference between now and {reload::%uuid of player%} < {reloadtime::%uuid of player%}:
                stop
        set {reloadtime::%uuid of player%} to 0
        if {glockAmmo::%uuid of player%} <= 0:
            play sound "minecraft:empty" to player
            stop
        if {glockCooldown::%uuid of player%} is set:
            if difference between now and {glockCooldown::%uuid of player%} < 0.2 seconds:
                stop
        set {glockCooldown::%uuid of player%} to now
        if {glockAmmo::%uuid of player%} is not set:
            set {glockAmmo::%uuid of player%} to 10
        else:
            add -1 to {glockAmmo::%uuid of player%}

        set custom model data strings of player's tool to "glockflash"


        recoil(player, "0.1 seconds")
        #wait 1 tick
        set {_pLoc} to location of player
        play sound "minecraft:glock" with volume 20 at {_pLoc}
        # add 1 to y-coordinate of {_pLoc}
        #broadcast "%round((x-coordinate of {_ploc}))%"
        execute console command "/execute in minecraft:%{map}%2 run setblock %round((x-coordinate of {_ploc}))% %round((y-coordinate of {_ploc}))% %round((z-coordinate of {_ploc}))% light[level=7] replace"
        set {_impactloc} to shoot(player, 60, 1, 5, 0.3, 0.15, 0)

        set {_dir} to normalized vector from yaw player's yaw and pitch player's pitch
        set vector length of {_dir} to 1

        set {_dust} to dust particle using dustOption(rgb(0, 0, 0), 1)
        draw {_dust} at {_impactloc}
        set {lastRightClick::%uuid of player%} to now
        wait 1 tick
        wait 2 ticks
        set custom model data strings of player's tool to "glock"
        execute console command "/execute in minecraft:%{map}%2 run setblock %round((x-coordinate of {_ploc}))% %round((y-coordinate of {_ploc}))% %round((z-coordinate of {_ploc}))% air replace"



