# Minigun
on right click:
    if player is holding a pink dye:
        if {reload::%uuid of player%} is set:
            if difference between now and {reload::%uuid of player%} < {reloadtime::%uuid of player%}:
                stop
        set {reloadtime::%uuid of player%} to 0
        if {miniCooldown::%uuid of player%} is set:
            if difference between now and {miniCooldown::%uuid of player%} < 0.19 seconds:
                stop
        set {miniCooldown::%uuid of player%} to now

        if {minigunRev::%uuid of player%} is not set:
            set {minigunRev::%uuid of player%} to 0
            play sound "minecraft:minigunrev" with volume 1 at location of player
        set {_combo} to difference between {lastRightClick::%uuid of player%} and now
        if {_combo} > 0.4 seconds:
            set {lastRightClick::%uuid of player%} to now
            clear {minigunRev::%uuid of player%}
            stop
        set {lastRightClick::%uuid of player%} to now
        add 1 to {minigunRev::%uuid of player%}
        if {minigunRev::%uuid of player%} < 12:
            stop

        if {miniAmmo::%uuid of player%} <= 0:
            play sound "minecraft:empty" to player
            stop
        if {miniAmmo::%uuid of player%} is not set:
            set {miniAmmo::%uuid of player%} to 50
        else:
            add -1 to {miniAmmo::%uuid of player%}

        play sound "minecraft:minigun" with volume 20 at location of player
        set {_impactloc} to shoot(player, 300, 4, 6, 2.8, 2.8, 0)
        set {_pLoc} to location of player
        execute console command "/execute in minecraft:%{map}%2 run setblock %round((x-coordinate of {_ploc}))% %round((y-coordinate of {_ploc}))% %round((z-coordinate of {_ploc}))% light[level=7] replace"
        set {_dir} to normalized vector from yaw player's yaw and pitch player's pitch
        set vector length of {_dir} to 1

        set {_dust} to dust particle using dustOption(rgb(0, 0, 0), 1)
        draw {_dust} at {_impactloc}
        wait 2 ticks
        play sound "minecraft:minigun" with volume 20 at location of player
        set {_impactloc} to shoot(player, 300, 4, 6, 2.8, 2.8, 0)

        set {_dir} to normalized vector from yaw player's yaw and pitch player's pitch
        set vector length of {_dir} to 1

        set {_dust} to dust particle using dustOption(rgb(0, 0, 0), 1)
        draw {_dust} at {_impactloc}
        wait 1 tick
        execute console command "/execute in minecraft:%{map}%2 run setblock %round((x-coordinate of {_ploc}))% %round((y-coordinate of {_ploc}))% %round((z-coordinate of {_ploc}))% air replace"
    
